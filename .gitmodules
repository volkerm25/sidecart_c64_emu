[submodule "pico-sdk"]
	path = pico-sdk
	url = https://github.com/raspberrypi/pico-sdk.git
[submodule "pico-extras"]
	path = pico-extras
	url = https://github.com/raspberrypi/pico-extras.git
[submodule "fatfs-sdk"]
	path = fatfs-sdk
	url = https://github.com/carlk3/no-OS-FatFS-SD-SDIO-SPI-RPi-Pico.git
[submodule "third_party/MCUME"]
	path = third_party/MCUME
	url = https://github.com/Jean-MarcHarvengt/MCUME.git
	shallow = true
